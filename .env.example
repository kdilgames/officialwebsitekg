# KDILGAMES Marketplace — environment variables
#
# The Stripe Projects CLI writes the real .env from provisioned resources:
#   stripe projects env --pull
# Extra values that do not come from a provider are stored as project variables:
#   stripe projects variables set <name> --env-key <KEY> --value "<value>"
# Do not hand-edit .env — it is regenerated by the CLI.

# ---- Database (from Supabase / any PostgreSQL provider) ----
# Pooled connection (PgBouncer, port 6543) used by the Next.js runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma Migrate / introspection.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---- Supabase (Auth + private Storage) ----
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server-only. Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---- Canonical site URL (used for auth redirects and Stripe return URLs) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Stripe Connect (platform account) ----
# Leave empty to disable payments. The app never fakes a successful payment.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Commission applied when no more specific rule exists, in basis points (1500 = 15%).
PLATFORM_COMMISSION_BPS="1500"
# Days a seller earning stays PENDING before it becomes withdrawable.
EARNINGS_HOLD_DAYS="7"

# ---- Operational ----
# Secret for the scheduled maintenance/release endpoint (payout release, reconciliation).
CRON_SECRET=""
