# KDILGAMES Marketplace — environment variables
#
# The Stripe Projects CLI writes the real .env from provisioned resources:
#   stripe projects env --pull
# Extra values that do not come from a provider are stored as project variables:
#   stripe projects variables set <name> --env-key <KEY> --value "<value>"
# Do not hand-edit .env — it is regenerated by the CLI.

# ---- Database (from Supabase / any PostgreSQL provider) ----
# Pooled connection (PgBouncer, port 6543) used by the Next.js runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma Migrate / introspection.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---- Supabase (Auth + private Storage) ----
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server-only. Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---- Canonical site URL (used for auth redirects and Stripe return URLs) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Stripe Connect (platform account) ----
# Leave empty to disable payments. The app never fakes a successful payment.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Enable Stripe Tax for automatic EU VAT calculation & EU VAT ID collection.
# Falls back cleanly if Stripe Tax is not activated in your Stripe Dashboard.
STRIPE_AUTOMATIC_TAX="false"
# Stripe Tax product tax code (default txcd_10000000 = Electronically Supplied Services).
STRIPE_TAX_CODE="txcd_10000000"
# Commission applied when no more specific rule exists, in basis points (1500 = 15%).
PLATFORM_COMMISSION_BPS="1500"
# Days a seller earning stays PENDING before it becomes withdrawable.
EARNINGS_HOLD_DAYS="7"

# ---- Operational ----
# Secret for the scheduled maintenance/release endpoint (payout release, reconciliation).
CRON_SECRET=""

# ---- Administration (email-based owner & admin access) ----
# Primary owner email automatically granted protected admin privileges once verified.
# Defaults to kdilgames@gmail.com when omitted.
ADMIN_OWNER_EMAIL="kdilgames@gmail.com"
# Optional comma-separated additional admin emails granted access once verified.
ADMIN_EMAILS=""

# ---- Observability (Sentry — completely optional) ----
# Leave empty to disable Sentry reporting without impacting build or runtime.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- Bot protection (Cloudflare Turnstile — completely optional) ----
# When omitted, forms render without the Turnstile challenge and server validation passes gracefully.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- Transactional Email (Resend — completely optional) ----
# When omitted, emails are logged/skipped gracefully without blocking orders, updates, or support tickets.
RESEND_API_KEY=""
EMAIL_FROM="KDILGAMES <noreply@kdilgames.com>"
SUPPORT_EMAIL="kdilgames@gmail.com"

